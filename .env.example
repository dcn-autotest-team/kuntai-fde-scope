# 环境变量配置示例

# 数据库连接配置 (默认使用本地 SQLite)
DATABASE_URL=sqlite:///./kuntai_fde.db

# 生产环境无缝切换至 MySQL 示例：
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/kuntai_fde?charset=utf8mb4

# 管理员密码 SHA-256 哈希值 (默认密码: admin123)
ADMIN_PWD_HASH=c638bc74f30482cae5ec685f12c435196bca31a591b6943157e6f38c973ad467
